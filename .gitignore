# =====================================================================
# Taquilla · archivos que NO se suben al repositorio
# Regla general: se versiona el código fuente y la configuración compartida;
# se ignora lo que se genera, se descarga o es propio de cada equipo.
# =====================================================================

# --- Dependencias (se reinstalan con `npm install` desde package-lock.json) ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Salidas de compilación de Next.js (se regeneran con `npm run dev` / `npm run build`) ---
/.next/
/out/
/build

# --- Tipos generados por Next.js (se crean al ejecutar dev/build) ---
next-env.d.ts
*.tsbuildinfo

# --- Pruebas y cobertura ---
/coverage
/playwright-report/
/test-results/

# --- Variables de entorno: pueden tener secretos, nunca se suben ---
# .env.example sí se sube: documenta qué variables existen, sin valores reales.
.env
.env*
!.env.example

# --- Logs y depuración ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Editores (configuración personal de cada persona) ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Despliegue ---
.vercel
*.pem

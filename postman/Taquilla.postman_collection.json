        {
          "name": "Error: idioma no soportado (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"El error tiene la forma del contrato { error: { codigo, mensaje } }\", () => {",
                  "    const e = pm.response.json().error;",
                  "    pm.expect(e).to.be.an(\"object\");",
                  "    pm.expect(e.codigo).to.be.a(\"string\");",
                  "    pm.expect(e.mensaje).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"El código es idioma_no_soportado\", () => pm.expect(pm.response.json().error.codigo).to.eql(\"idioma_no_soportado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/textos?idioma=fr",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "textos"
              ],
              "query": [
                {
                  "key": "idioma",
                  "value": "fr"
                }
              ]
            },
            "description": "Un idioma que no existe responde 400 `idioma_no_soportado`. El frontend nunca lo pide: lee la cookie `idioma` y usa `es` si no es válida.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Vista 1 · Inicio público",
      "description": "Datos de la portada: evento principal del hero, destacados, categorías y próximos por ciudad (CONTRATO.md, sección 3).",
      "item": [
        {
          "name": "Eventos destacados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json().datos;",
                  "pm.test(\"Devuelve una lista de eventos\", () => pm.expect(datos).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"Cada evento trae lo que pinta la tarjeta\", () => {",
                  "    datos.forEach(e => {",
                  "        pm.expect(e).to.include.keys(\"slug\", \"titulo\", \"categoria\", \"fecha\", \"recinto\", \"precioDesde\", \"afiche\", \"disponibilidad\");",
                  "        pm.expect(e.precioDesde).to.be.a(\"number\");",
                  "    });",
                  "});",
                  "pm.test(\"El afiche no es una foto: son dos colores y un patrón\", () => {",
                  "    pm.expect(datos[0].afiche).to.include.keys(\"color1\", \"color2\", \"patron\");",
                  "});",
                  "pm.collectionVariables.set(\"slug\", datos[0].slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }

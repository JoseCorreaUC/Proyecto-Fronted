    {
      "name": "5. Sesión (Vistas 4 y 5)",
      "description": "Ingreso, usuario de la sesión y salida. El frontend hace el ingreso en una Server Action y guarda el token en una cookie httpOnly propia, nunca en localStorage (CONTRATO.md, sección 1).",
      "item": [
        {
          "name": "Ingresar con una cuenta de prueba",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve el usuario y un token\", () => {",
                  "    pm.expect(r.usuario).to.include.keys(\"id\", \"nombre\", \"correo\", \"rol\");",
                  "    pm.expect(r.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"token\", r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sesion"
              ]
            },
            "description": "Cuenta de prueba publicada en el contrato. Guarda el `token` en una variable para las peticiones que piden sesión.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoPrueba}}\",\n  \"clave\": \"{{clavePrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Usuario de la sesión (con token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es la persona que ingresó\", () => {",
                  "    const r = pm.response.json();",
                  "    const usuario = r.usuario ?? r;",
                  "    pm.expect(usuario.correo).to.eql(pm.variables.get(\"correoPrueba\"));",
                  "});"
                ]
              }

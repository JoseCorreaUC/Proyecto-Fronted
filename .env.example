# Copia este archivo como .env.local y ajusta los valores. .env.local no se sube al repositorio.
# En Vercel, define las mismas variables en Settings → Environment Variables.

# Obligatoria: dirección base de la API (sin barra final). Sin ella la aplicación no arranca.
API_URL=https://yanethm-taquilla-api.fly.dev/api/v1

# Opcional: ciudad del inicio si la API no devuelve ciudades (normalmente no hace falta).
# CIUDAD_PREDETERMINADA=Manizales

# Opcional: para ver los estados de carga y error de la interfaz (ver CONTRATO.md, sección 1).
# API_SIMULAR_LATENCIA=2000
# API_SIMULAR_ERROR=503

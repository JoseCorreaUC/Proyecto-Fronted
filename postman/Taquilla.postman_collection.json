            "description": "Responde 201, deja la sesión abierta y trae el código para verificar el correo. La confirmación de contraseña y los términos se validan en el frontend.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Persona de Prueba\",\n  \"correo\": \"{{correoNuevo}}\",\n  \"clave\": \"una-clave-larga\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }

    {
      "name": "6. Registro y verificación del correo (Vista 5)",
      "description": "Crea una cuenta con un correo inventado distinto cada vez. La API no envía correos: el código llega en `codigoDePrueba` (CONTRATO.md, sección 7).",
      "item": [
        {
          "name": "Crear cuenta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Un correo distinto en cada ejecución para no chocar con correo_en_uso.",
                  "pm.collectionVariables.set(\"correoNuevo\", `sustentacion-${Date.now()}@taquilla.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"La cuenta queda sin verificar y trae el código de prueba\", () => {",
                  "    pm.expect(r.usuario.correoVerificado).to.eql(false);",
                  "    pm.expect(r.verificacion.codigoDePrueba).to.match(/^\\d{6}$/);",
                  "});",
                  "pm.collectionVariables.set(\"codigoVerificacion\", r.verificacion.codigoDePrueba);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
